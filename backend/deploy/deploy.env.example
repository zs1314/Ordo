# Copy to deploy/deploy.env (not committed) and fill in. setup.sh, deploy.sh and demo.sh read it.
HOST=my-server                         # ssh host; an alias from ~/.ssh/config works
APP=todo                               # system user and service; code in /opt/$APP, data in /var/lib/$APP, settings in /etc/$APP.env
DOMAIN=todo.example.com                # the board, behind nginx with a Let's Encrypt certificate
PORT=4404                              # the board listens on 127.0.0.1:$PORT
SERVER_TZ=UTC                          # time zone the server uses for "today" (recurring items, due dates)
PASSWORD_FILE=~/.config/todo/password  # local file with the login password; leave empty for no login
CANVAS_HOST=                           # Canvas LMS host, e.g. canvas.instructure.com; empty: no Canvas sync
CANVAS_TOKEN_FILE=                     # local file with the Canvas access token (the token alone, or a CANVAS_TOKEN=... line)
DEMO_DOMAIN=                           # optional: where demo.sh serves the sample-data demo
